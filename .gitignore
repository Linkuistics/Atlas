# Cargo build artefacts
/target

# OS
.DS_Store

# Editor / scratch
work

# Claude Code state — directory itself is mostly machine-local (settings,
# scheduled-tasks lock, transient worktrees), but .claude/memory/ is the
# project's persistent memory and is tracked so it travels via git across
# machines. See scripts/setup-claude-memory.sh and .claude/memory/MEMORY.md.
.claude/*
!.claude/memory/
!.claude/memory/**

# atlas-cli default output (components.yaml et al.).
.atlas/*
!.atlas/
!.atlas/config.sprint.example.yaml

# atlas-eval regenerates the trend page from results/*.yaml
/evaluation/results/trend.html
